{
  "name": "shared-bookmark-sync-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:projection": "npm run build && node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs --release"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.29",
    "typescript": "^5.6.3"
  }
}
