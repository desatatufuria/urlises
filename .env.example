# Copy this file to .env and fill in real values before running
# docker compose -f docker-compose.prod.yml up -d --build
# See docs/deployment.md for the full deployment procedure.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shared_bookmark_sync

# Must point at the postgres service name on port 5432 (internal Docker network).
DATABASE_URL=postgres://postgres:change-me@postgres:5432/shared_bookmark_sync?sslmode=disable
DATABASE_AUTO_MIGRATE=true
DATABASE_MIGRATIONS_DIR=migrations
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=1

# --- Auth ---
# Generate a real secret, e.g. `openssl rand -hex 32`.
AUTH_JWT_SECRET=change-me
AUTH_CLIENT_ID_HEADER=X-Client-Id
AUTH_TOKEN_TTL=24h

# --- CORS ---
# Origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=https://admin.urlises.lab.example.com

# --- Mail ---
# Disabled by default since mailpit is not part of the prod stack.
# If enabled, configure a real SMTP provider using the vars below.
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_TLS_MODE=starttls
MAIL_AUTH_MODE=plain
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=mailer@urlises.lab.example.com
MAIL_FROM_DISPLAY_NAME=URLises
MAIL_REPLY_TO=support@urlises.lab.example.com

# Required when MAIL_ENABLED=true — used to build links in outgoing email
# (e.g. the invitation accept link). Must be a valid https URL with no
# query string or fragment; a trailing slash is trimmed automatically.
PUBLIC_BASE_URL=https://admin.urlises.lab.example.com

# Set to false to lock self-registration behind a valid, pending invitation.
# The very first owner account (bootstrap, before any organization exists)
# is never gated by this — only regular self-registration after that point.
OPEN_REGISTRATION_ENABLED=true

# --- Networking ---
# WireGuard IP (10.77.0.2) is recommended over the LAN IP so the host can move
# between hypervisors without touching Traefik. See docs/deployment.md.
BIND_ADDR=10.77.0.2
API_PORT=8080
ADMIN_PORT=8082

# Base URL baked into the admin-web static bundle at build time.
VITE_API_BASE_URL=https://api.urlises.lab.example.com
