      "lens": "risk",
      "location": "admin-web/src/lib/api/useUncertainCreationKey.ts:9-20",
      "severity": "CRITICAL",
      "claim": "Changed intents add map entries without clearing the prior uncertain intent, and production mutation hooks do not invoke or expose cancel; returning to a previously abandoned payload therefore reuses its old key instead of establishing a new creation intent.",
      "proof_refs": [
        "admin-web/src/lib/api/useUncertainCreationKey.ts:9-20",
        "admin-web/src/features/groups/mutations.ts:6-21",
        "admin-web/src/features/members/mutations.ts:8-23",
