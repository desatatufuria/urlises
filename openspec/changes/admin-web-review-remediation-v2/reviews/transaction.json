      "lens": "risk",
      "location": "admin-web/src/lib/api/useUncertainCreationKey.ts:22-24",
      "severity": "CRITICAL",
      "claim": "retainAfterFailure deletes the retained key for every ApiError, including the HTTP 409 produced while an identical command still holds the backend advisory lock; the next same-intent submission consequently uses a different idempotency identity while the original command may still complete.",
      "proof_refs": [
        "admin-web/src/lib/api/useUncertainCreationKey.ts:22-24",
        "backend/internal/httpapi/idempotency.go:107-113",
        "backend/internal/organizations/handler.go:206-214"
