      "lens": "resilience",
      "location": "admin-web/src/lib/api/useUncertainCreationKey.ts:22-24",
      "severity": "CRITICAL",
      "claim": "Every HTTP error deletes the retained creation key. This includes the server idempotency_in_progress response while the original request may still complete; another submission then receives a new key and can execute as a separate creation.",
      "proof_refs": [
        "admin-web/src/lib/api/client.ts:93-96",
        "admin-web/src/features/groups/mutations.ts:11-13",
        "backend/internal/httpapi/idempotency.go:107-113"
      ]
    },
    {
      "id": "RESILIENCE-002",
      "lens": "resilience",
      "location": "admin-web/src/lib/api/useUncertainCreationKey.ts:4-16",
      "severity": "CRITICAL",
      "claim": "Client intent identity trims and lowercases every string, while the server fingerprints the unnormalized decoded payload. Case or whitespace changes therefore reuse a key with a different server fingerprint, producing a conflict instead of a stable retry; subsequent key clearing permits a new creation identity.",
      "proof_refs": [
        "admin-web/src/lib/api/useUncertainCreationKey.test.ts:7-16",
        "backend/internal/httpapi/idempotency.go:85-95",
        "backend/internal/organizations/handler.go:202-204"
      ]
    },
