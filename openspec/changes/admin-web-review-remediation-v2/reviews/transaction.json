      "lens": "resilience",
      "location": "admin-web/src/lib/api/useUncertainCreationKey.ts:9-20",
      "severity": "CRITICAL",
      "claim": "Changing from unresolved intent A to intent B does not remove A's key from the map. Returning later to A reuses its stale key, so an earlier completed-but-unconfirmed creation can replay instead of executing the new intent.",
      "proof_refs": [
        "admin-web/src/lib/api/useUncertainCreationKey.ts:9-20",
