    {"id":"RESILIENCE-002","lens":"resilience","location":"backend/internal/workspaces/handler.go:173-181","severity":"BLOCKER","claim":"Unexpected service and database failures are returned as HTTP 400 by the admin handlers and the server adds no request error-reporting wrapper.","evidence_class":"deterministic","proof_refs":["backend/internal/organizations/handler.go:132-142","backend/internal/groups/handler.go:141-149","backend/internal/workspaces/handler.go:173-181"],"status":"corroborated"},
