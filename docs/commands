API=http://shared-bookmark-sync-backend:8080
CLIENT_ID="poc-$(cat /proc/sys/kernel/random/uuid)"
EMAIL="admin+$(date +%s)@example.com"
PASSWORD="poc-password"

SESSION=$(curl -fsS -X POST "$API/auth/register" \
  -H "Content-Type: application/json" \
  -H "X-Client-Id: $CLIENT_ID" \
  -d "{
    \"email\":\"$EMAIL\",
    \"name\":\"POC Admin\",
    \"password\":\"$PASSWORD\",
    \"deviceName\":\"Manual test\"
  }")

TOKEN=$(jq -r '.accessToken' <<<"$SESSION")

curl -fsS -X POST "$API/organizations" \
  -H "Authorization: Bearer $TOKEN" \
  -H "X-Client-Id: $CLIENT_ID" \
  -H "Idempotency-Key: $(cat /proc/sys/kernel/random/uuid)" \
  -H "Content-Type: application/json" \
  -d '{"name":"POC Organization"}' | jq

printf 'Email: %s\nPassword: %s\n' "$EMAIL" "$PASSWORD"
